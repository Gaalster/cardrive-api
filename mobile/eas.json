{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "true",
        "EXPO_PUBLIC_ENABLE_NATIVE_CHECKOUT": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_ENABLE_NATIVE_CHECKOUT": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "connected-preview": {
      "extends": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_ENABLE_NATIVE_CHECKOUT": "false",
        "EXPO_PUBLIC_API_URL": "https://cardrive-native.onrender.com",
        "EXPO_PUBLIC_ADMOB_BANNER_ID": "ca-app-pub-2258285180527094/8273970559"
      }
    },
    "play-internal": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cardrive-native.onrender.com",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_ENABLE_NATIVE_CHECKOUT": "false",
        "EXPO_PUBLIC_ADS_DISABLED": "true",
        "EXPO_PUBLIC_ADS_LIVE": "false"
      }
    }
  }
}
